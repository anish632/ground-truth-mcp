{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ground-truth-mcp",
	"main": "./src/index.ts",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "GroundTruthMCP"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "API_KEYS",
			"id": "17cb68041ac949a28da18b251fd39245"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GroundTruthMCP"]
		},
		// v2 purged every GroundTruthMCP Durable Object instance (analytics +
		// thousands of abandoned MCP session objects that pushed the account past
		// the free-tier DO storage cap). KV (API_KEYS: keys, billing, quotas) was
		// unaffected. v3 recreates the class fresh. Applied 2026-11-05.
		{
			"tag": "v2",
			"deleted_classes": ["GroundTruthMCP"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["GroundTruthMCP"]
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	}
}
